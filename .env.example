# Mocksy — Environment Variables
# Copy this file to .env.local and fill in the values.

# Public site URL used for metadata (OpenGraph, sitemap, etc.)
# Defaults to http://localhost:3000 if not set.
NEXT_PUBLIC_SITE_URL=

# Base URL for Playwright e2e tests and OG image generation script.
# Defaults to http://localhost:3000 if not set.
BASE_URL=
